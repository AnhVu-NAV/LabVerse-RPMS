<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- res/values/styles.xml -->
    <style name="Widget.LabVerse.OutlinedField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundMode">outline</item>
        <item name="boxStrokeColor">#D1D5DB</item>
<!--        <item name="boxStrokeColorFocused">#1D61E7</item>-->
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="hintTextColor">#9CA3AF</item>
    </style>


    <style name="Widget.LabVerse.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="Widget.LabVerse.OutlineButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">#E5E7EB</item>
        <item name="strokeWidth">1dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:textColor">#111827</item>
        <item name="iconTint">#111827</item>
        <item name="android:backgroundTint">?attr/colorSurface</item>
    </style>

    <style name="Widget.LabVerse.OtpBox" parent="">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:background">@drawable/bg_otp_box_selector</item>
        <item name="android:gravity">center</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:importantForAutofill">no</item>
        <item name="android:imeOptions">flagNoFullscreen</item>
    </style>

    <style name="Widget.Otp.Box" parent="@style/Widget.Otp.Box">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">@dimen/otp_box_size</item>
        <item name="android:maxWidth">@dimen/otp_box_size</item>
        <item name="android:minWidth">36dp</item>
        <item name="android:layout_margin">@dimen/otp_box_spacing</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_otp_box</item>
        <item name="android:inputType">number</item>
        <item name="android:maxLength">1</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <!-- res/values/styles.xml -->
    <style name="RoleCard" parent="Widget.Material3.CardView.Outlined">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:padding">10dp</item>
        <item name="shapeAppearance">@style/Shape.Corner.Medium</item>

        <!-- đồng bộ nền trắng, không bị overlay -->
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardElevation">0dp</item>

        <!-- viền & ripple -->
        <item name="strokeColor">@color/role_card_stroke</item>
        <item name="strokeWidth">0.5dp</item>
        <item name="rippleColor">@android:color/transparent</item>
    </style>



