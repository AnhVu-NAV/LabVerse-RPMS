<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:background="@color/search_background"
    android:gravity="center_vertical">

    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_recent_search_icon">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_history"
            android:contentDescription="@string/cd_search_icon" />
    </FrameLayout>

    <TextView
        android:id="@+id/tv_search_query"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:textColor="@color/search_text"
        android:textSize="16sp"
        android:fontFamily="sans-serif"
        android:text="@string/search_history_ai_education"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/iv_remove"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:src="@drawable/ic_close"
        android:padding="4dp"
        android:contentDescription="@string/cd_remove_search_history" />

</LinearLayout>

