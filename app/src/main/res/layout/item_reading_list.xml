<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="2dp"
    android:clickable="true"
    android:focusable="true"
    android:longClickable="true"
    android:descendantFocusability="blocksDescendants"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvReadingListName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Reading List Name"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#121417" />

            <!-- More button -->
            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_more"
                android:tint="#61758A"
                android:contentDescription="More options"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tvReadingListDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description of the reading list"
            android:textSize="14sp"
            android:textColor="#61758A"
            android:layout_marginTop="8dp"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Footer info -->
        <TextView
            android:id="@+id/tvReadingListDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Created: 2 days ago"
            android:textSize="12sp"
            android:textColor="#94A3B8"
            android:layout_marginTop="8dp" />
    </LinearLayout>
</androidx.cardview.widget.CardView>