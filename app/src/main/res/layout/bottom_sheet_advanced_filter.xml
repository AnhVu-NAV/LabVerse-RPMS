<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_bottom_sheet">

    <!-- Bottom Sheet Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_bottom_sheet_handle"
        android:contentDescription="@string/cd_bottom_sheet_handle" />

    <!-- Title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="12dp"
        android:text="@string/advanced_filter_title"
        android:textColor="@color/search_text"
        android:textSize="22sp"
        android:fontFamily="sans-serif-bold" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Author Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="@string/filter_author_label"
                    android:textColor="@color/search_text"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <EditText
                    android:id="@+id/et_filter_author"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_filter_input"
                    android:hint="@string/filter_author_hint"
                    android:textColorHint="@color/search_hint"
                    android:textColor="@color/search_text"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:inputType="textPersonName"
                    android:autofillHints="name"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <!-- Journal Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="@string/filter_journal_label"
                    android:textColor="@color/search_text"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <EditText
                    android:id="@+id/et_filter_journal"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_filter_input"
                    android:hint="@string/filter_journal_hint"
                    android:textColorHint="@color/search_hint"
                    android:textColor="@color/search_text"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:inputType="text"
                    android:autofillHints="journalName"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <!-- Tag Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="@string/filter_tag_label"
                    android:textColor="@color/search_text"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <EditText
                    android:id="@+id/et_filter_tag"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_filter_input"
                    android:hint="@string/filter_tag_hint"
                    android:textColorHint="@color/search_hint"
                    android:textColor="@color/search_text"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:inputType="text"
                    android:autofillHints="tag"
                    android:importantForAutofill="no" />
            </LinearLayout>

            <!-- Publication Year Field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="8dp"
                    android:text="@string/filter_year_label"
                    android:textColor="@color/search_text"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium" />

                <LinearLayout
                    android:id="@+id/ll_filter_year"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_filter_input"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/tv_filter_year"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:paddingEnd="8dp"
                        android:text="@string/filter_year_hint"
                        android:textColor="@color/search_hint"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_calendar"
                        android:contentDescription="@string/cd_calendar_icon" />
                </LinearLayout>
            </LinearLayout>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="24dp"
                android:paddingBottom="16dp"
                android:gravity="center"
                android:weightSum="2">

                <Button
                    android:id="@+id/btn_reset"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/btn_reset_filter"
                    android:textColor="@color/primary"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:background="@drawable/bg_filter_input"
                    style="?attr/materialButtonOutlinedStyle" />

                <Button
                    android:id="@+id/btn_apply"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_apply_filter"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-medium"
                    android:backgroundTint="@color/primary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>

