<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvAnnotations"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/annotations_content"
        android:textSize="16sp"
        android:textColor="@android:color/black"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnExportAnnotation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Export Annotations"
        app:layout_constraintTop_toBottomOf="@id/tvAnnotations"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btnImportAnnotation"
        app:layout_constraintHorizontal_chainStyle="spread"
        android:layout_marginTop="16dp" />

    <Button
        android:id="@+id/btnImportAnnotation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Import Annotations"
        app:layout_constraintTop_toBottomOf="@id/tvAnnotations"
        app:layout_constraintStart_toEndOf="@id/btnExportAnnotation"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
