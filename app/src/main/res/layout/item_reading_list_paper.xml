<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Paper Title & Priority Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvPaperTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Paper Title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#121417"
                android:maxLines="2"
                android:ellipsize="end" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPriority"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HIGH"
                android:textColor="@android:color/white"
                style="@style/Widget.MaterialComponents.Chip.Action"
                app:chipBackgroundColor="@android:color/holo_red_dark"
                app:chipCornerRadius="8dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- Paper Authors -->
        <TextView
            android:id="@+id/tvPaperAuthors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Author: Author Name"
            android:textSize="14sp"
            android:textColor="#61758A"
            android:layout_marginTop="4dp"
            android:maxLines="1"
            android:ellipsize="end" />


        <!-- Action Button -->
        <Button
            android:id="@+id/btnSetPriority"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set Priority"
            android:textColor="@android:color/holo_blue_dark"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_gravity="end"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
